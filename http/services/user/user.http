###
# Récupérer le client d'ID n°1
GET http://user.service.riptest:8282/user/getUserById/1
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

###
# Supprimer le client d'ID n°1
DELETE http://user.service.riptest:8282/user/deleteuserById/1
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

###
# Créer un nouveau client
POST http://user.service.riptest:8282/user/signup
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

{
    "email": "tesxxt@test.com",
    "phone": "33650717809",
    "lastnames": "BASTARD RABASTE",
    "firstnames": "william",
    "password": "password"
}

###
# Remplace les données d'un client
PUT http://user.service.riptest:8282/user/update
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

{
    "account": {
        "uuid": "45646",
        "firstnames": "william",
        "lastnames": "BASTARD RABASTE",
        "street_address1": "15 rue georges gay",
        "street_address2": "Batiment 11-12",
        "street_address3": "ETG 2 APT 204",
        "zipcode": "93130",
        "city": "Noisy-Le-Sec",
        "country": "France",
        "phone": "33650717809"
    }
}


