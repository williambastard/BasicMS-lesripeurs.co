###
# Récupérer le client d'ID n°1
GET http://user.gateway.riptest:8282/user/getUserById/1
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

###
# Supprimer le client d'ID n°1
DELETE http://user.gateway.riptest:8282/user/deleteuserById/1
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

###
# Supprimer le client d'email test@test.fr
DELETE http://user.gateway.riptest:8282/user/deleteuserById/test@test.fr
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}


###
# Créer un nouveau client
POST http://user.gateway.riptest:8282/user/signup
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

{
    "lastnames": "BASTARD RABASTE",
    "firstnames": "william",
    "phone": "33650717809",
    "email": "test@test.fr",
    "password": "testpassword123"
}

###
# Remplace les données d'un client
PUT http://user.gateway.riptest:8282/user/update
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

{
    "lastnames": "BASTARD RABASTE",
    "firstnames": "william",
    "phone": "33650717809",
    "email": "test@test.fr",
    "password": "testpassword123"
}

###
# Remplace partiellement les données d'un client
PATCH http://user.gateway.riptest:8282/user/update
Cache-Control: max-age=604800
Content-Type: application/json
Origin: {{$dotenv ORIGIN}}
Authorization: token {{$dotenv AUTHORIZATION_TOKEN}}

{
    "lastnames": "BASTARD RABASTE",
    "firstnames": "william",
    "phone": "33650717809",
    "email": "test@test.fr",
    "password": "testpassword123"
}