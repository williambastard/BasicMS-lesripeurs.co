generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId         Int      @id @default(autoincrement())
  email      String   @unique
  phone      String   @db.VarChar(15)
  lastnames  String
  firstnames String
  password   String
  createdAt  DateTime @default(now())
}
